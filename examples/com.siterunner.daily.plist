<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.siterunner.daily</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Applications/Site Runner.app/Contents/MacOS/Site Runner</string>
    <string>--run-all</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>9</integer><key>Minute</key><integer>0</integer></dict>
  <key>StandardOutPath</key><string>/tmp/site-runner-daily.stdout.log</string>
  <key>StandardErrorPath</key><string>/tmp/site-runner-daily.stderr.log</string>
</dict>
</plist>
