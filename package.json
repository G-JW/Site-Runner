{
  "name": "site-runner",
  "version": "0.3.9",
  "private": true,
  "description": "Local-first browser automation desktop app",
  "author": "Site Runner Contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/G-JW/Site-Runner.git"
  },
  "homepage": "https://github.com/G-JW/Site-Runner",
  "main": "dist/main/main/index.js",
  "type": "module",
  "scripts": {
    "icons:generate": "node scripts/generate-app-icons.mjs",
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"tsc -p tsconfig.main.json --watch --preserveWatchOutput\" \"wait-on tcp:5173 file:dist/main/main/index.js && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "start": "electron .",
    "lint": "eslint src tests --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "test": "vitest run",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "build": "pnpm build:main && pnpm build:renderer",
    "prepare:browsers": "cross-env PLAYWRIGHT_BROWSERS_PATH=.playwright-browsers playwright install chromium",
    "package": "pnpm prepare:browsers && pnpm build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --dir --publish never",
    "package:dist": "pnpm prepare:browsers && pnpm build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --publish never",
    "release:package": "pnpm prepare:browsers && pnpm build && node scripts/package-release.mjs",
    "release:manifest": "node scripts/create-update-manifest.mjs"
  },
  "dependencies": {
    "@monaco-editor/react": "latest",
    "esbuild": "latest",
    "monaco-editor": "latest",
    "node-cron": "latest",
    "pino": "latest",
    "playwright": "latest",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "concurrently": "latest",
    "cross-env": "latest",
    "electron": "latest",
    "electron-builder": "latest",
    "eslint": "latest",
    "eslint-plugin-react-hooks": "latest",
    "eslint-plugin-react-refresh": "latest",
    "globals": "latest",
    "prettier": "latest",
    "typescript": "^6.0.0",
    "typescript-eslint": "latest",
    "vite": "latest",
    "vitest": "latest",
    "wait-on": "latest"
  },
  "build": {
    "appId": "com.siterunner.desktop",
    "productName": "Site Runner",
    "afterPack": "scripts/after-pack.mjs",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "node_modules/**/*",
      "assets/branding/icon.png",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/esbuild/**/*",
      "node_modules/@esbuild/**/*"
    ],
    "extraResources": [
      {
        "from": ".playwright-browsers",
        "to": "playwright-browsers"
      }
    ],
    "mac": {
      "asar": false,
      "icon": "assets/branding/icon.icns",
      "category": "public.app-category.productivity",
      "target": [
        "dir"
      ]
    },
    "win": {
      "icon": "assets/branding/icon.ico",
      "artifactName": "Site Runner.${ext}",
      "target": [
        "portable"
      ]
    },
    "linux": {
      "icon": "assets/branding/icon.png",
      "target": [
        "AppImage"
      ],
      "category": "Utility"
    }
  },
  "packageManager": "pnpm@11.19.0"
}
