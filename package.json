{
  "name": "site-runner",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first browser automation desktop app",
  "main": "dist/main/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"tsc -p tsconfig.main.json --watch --preserveWatchOutput\" \"wait-on tcp:5173 file:dist/main/main/index.js && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "start": "electron .",
    "lint": "eslint src tests --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "test": "vitest run",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "build": "pnpm build:main && pnpm build:renderer",
    "package": "pnpm build && electron-builder --dir",
    "package:dist": "pnpm build && electron-builder"
  },
  "dependencies": {
    "@monaco-editor/react": "latest",
    "esbuild": "latest",
    "monaco-editor": "latest",
    "node-cron": "latest",
    "pino": "latest",
    "playwright": "latest",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "concurrently": "latest",
    "cross-env": "latest",
    "electron": "latest",
    "electron-builder": "latest",
    "eslint": "latest",
    "eslint-plugin-react-hooks": "latest",
    "eslint-plugin-react-refresh": "latest",
    "globals": "latest",
    "prettier": "latest",
    "typescript": "^6.0.0",
    "typescript-eslint": "latest",
    "vite": "latest",
    "vitest": "latest",
    "wait-on": "latest"
  },
  "build": {
    "appId": "com.siterunner.desktop",
    "productName": "Site Runner",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/playwright/**/*",
      "node_modules/playwright-core/**/*"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": ["dir"]
    },
    "win": {
      "target": ["portable"]
    },
    "linux": {
      "target": ["AppImage"],
      "category": "Utility"
    }
  },
  "packageManager": "pnpm@11.19.0"
}
